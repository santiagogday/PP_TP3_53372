not(0,1).
not(1,0).


and(0, 0, 0).
and(0, 1, 0).
and(1, 0, 0).
and(1, 1, 1).

or(0, 0, 0).
or(0, 1, 1).
or(1, 0, 1).
or(1, 1, 1).

circuito(Q1, Q2, S) :-
    not(Q1, NQ1),      
    not(Q2, NQ2),      
    and(NQ1, Q2, A1),  
    and(Q1, NQ2, A2),  
    or(A1, A2, S).     



