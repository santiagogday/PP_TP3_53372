descendiente(Padre, persona(NomHijo, DniHijo, EdadHijo)) :-
    hijo(NomHijo, Padre),
    persona(NomHijo, DniHijo, EdadHijo).

descendiente(Padre, Desc) :-
    hijo(Hijo, Padre),
    descendiente(Hijo, Desc).


ascendiente(Hijo, persona(NomPadre, DniPadre, EdadPadre)) :-
    hijo(Hijo, NomPadre),
    persona(NomPadre, DniPadre, EdadPadre).

ascendiente(Hijo, Asc) :-
    hijo(Hijo, Padre),
    ascendiente(Padre, Asc).
